#!/usr/bin/env bash
# aurora-up: build what is needed and run the whole Aurora stack in the
# foreground: busd, controllerd and indexd under a supervisor (restarts, health;
# see `auroractl status`), a headless compositor with a small scene, and, if
# built, the Haiku ledger app. Ctrl-C (or SIGTERM) stops everything and removes
# the domains, cgroups, sockets and temp files it made.
#
#   aurora-up [flags]         start (default run dir /tmp/aurora-up-UID)
#   aurora-up --env           print `export` lines for a shell that wants to drive a running stack
#   aurora-up --build-only    build and exit
# Flags: --no-compositor --no-haiku --no-windows --no-fixtures --no-build
#        --require-isolation --no-test-input --dump-overlay FILE --size WxH
#        --approval-timeout DUR --run DIR -h
set -uo pipefail
ROOT=$(cd "$(dirname "$0")" && pwd)
BIN=$ROOT/build/bin
COMP=$ROOT/compositor/target/release/aurora-compositor
EXAMPLES=$ROOT/compositor/target/release/examples
CAPTURE=$ROOT/harness/capture/target/release/aurora-capture
LEDGER=$ROOT/kits/build/haiku_ledger
RUN=${AURORA_RUN:-/tmp/aurora-up-$(id -u)}
COMPOSITOR=1 HAIKU=1 WINDOWS=1 FIXTURES=1 BUILD=1 BUILD_ONLY=0 ISOLATION= TESTINPUT=1 DUMP= SIZE=1280x800 APPROVAL=60s

while [ $# -gt 0 ]; do case $1 in
  --no-compositor) COMPOSITOR=0;; --no-haiku) HAIKU=0;; --no-windows) WINDOWS=0;;
  --no-fixtures) FIXTURES=0;; --no-build) BUILD=0;; --build-only) BUILD_ONLY=1;;
  --require-isolation) ISOLATION=--require-isolation;; --no-test-input) TESTINPUT=0;;
  --dump-overlay) DUMP=$2; shift;; --size) SIZE=$2; shift;; --approval-timeout) APPROVAL=$2; shift;;
  --run) RUN=$2; shift;;
  --env) [ -f "$RUN/env" ] && cat "$RUN/env" || { echo "aurora-up: no running stack in $RUN" >&2; exit 1; }; exit 0;;
  -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
  *) echo "aurora-up: unknown flag $1 (try -h)" >&2; exit 2;;
esac; shift; done

say() { printf '%s\n' "$*"; }
die() { printf 'aurora-up: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- build
build() {
  say "== build"
  mkdir -p "$BIN"
  (cd "$ROOT/bus" && go build -o "$BIN/" ./cmd/busd ./cmd/bus) || die "bus build failed"
  (cd "$ROOT/adapter/linux" && go build -o "$BIN/domain" ./cmd/domain) || die "domain build failed"
  # aurora-preflight runs INSIDE a domain, so it is built static (CGO_ENABLED=0):
  # it publishes the approval request over the domain's own bus socket, which is
  # what lets busd stamp the identity instead of the controller asserting it.
  (cd "$ROOT/controller" && go build -o "$BIN/" ./cmd/controllerd ./cmd/controller \
     && CGO_ENABLED=0 go build -o "$BIN/aurora-preflight" ./cmd/aurora-preflight) || die "controller build failed"
  (cd "$ROOT/shell" && GOWORK=off go build -o "$BIN/aurora" ./cmd/aurora && GOWORK=off go build -o "$BIN/powerbox" ./cmd/powerbox) || die "shell build failed"
  (cd "$ROOT/index" && go build -o "$BIN/indexd" ./cmd/indexd) || die "indexd build failed"
  (cd "$ROOT/supervisor" && go build -o "$BIN/" ./cmd/supervisord ./cmd/auroractl) || die "supervisor build failed"
  (cd "$ROOT/apps/lumen" && go build -o bin/lumen ./cmd/lumen && go build -o "$BIN/genimage" ./cmd/genimage) || die "lumen build failed"
  if [ $COMPOSITOR = 1 ]; then
    (cd "$ROOT/compositor" && cargo build --release --examples 2>&1 | tail -1) || die "compositor build failed"
    (cd "$ROOT/harness/capture" && cargo build --release 2>&1 | tail -1) || die "capture build failed"
  fi
  if [ $HAIKU = 1 ]; then
    if cmake -S "$ROOT/kits" -B "$ROOT/kits/build" -G Ninja >/dev/null 2>&1 && cmake --build "$ROOT/kits/build" >/dev/null 2>&1 && [ -x "$LEDGER" ]; then :
    else say "   (kits build failed or cmake/ninja missing: the Haiku app will be left out)"; HAIKU=0; fi
  fi
}
if [ $BUILD = 1 ] || [ $BUILD_ONLY = 1 ]; then build; fi
[ $BUILD_ONLY = 1 ] && { say "built into $BIN"; exit 0; }
for b in busd bus domain controllerd controller aurora aurora-preflight indexd supervisord auroractl; do [ -x "$BIN/$b" ] || die "$BIN/$b missing: run without --no-build"; done
[ $COMPOSITOR = 0 ] || { [ -x "$COMP" ] || die "compositor not built: run without --no-build, or pass --no-compositor"; }
[ $HAIKU = 0 ] || [ -x "$LEDGER" ] || HAIKU=0

# ---------------------------------------------------------------- run dir
PIDS=() NAMES=()
export XDG_RUNTIME_DIR=$RUN/xdg AURORA_DOMAINS_DIR=$RUN/domains AURORA_BUS_SOCK=$RUN/bus.sock
export AURORA_TRUSTED_SOCK=$RUN/xdg/aurora-trusted.sock AURORA_DOMAIN_BIN=$BIN/domain AURORA_SUPERVISOR_SOCK=$RUN/supervisor.sock
export AURORA_KITS_NS=up$$
INPUT=$RUN/input.sock

reap_children() {  # services the supervisor started, if it was SIGKILLed and could not stop them
  local n p
  [ -f "$RUN/supervisor/children" ] || return 0
  while read -r n p; do
    [ -n "${p:-}" ] && [ "$(readlink "/proc/$p/exe" 2>/dev/null)" != "" ] && case $(readlink "/proc/$p/exe") in "$BIN"/*) kill -9 "$p" 2>/dev/null;; esac
  done < "$RUN/supervisor/children"
}
sweep() {  # destroy the domains of a (possibly dead) run, then its sockets and files
  reap_children
  for d in "$RUN"/domains/*/; do [ -d "$d" ] && "$BIN/domain" destroy "$(basename "$d")" >/dev/null 2>&1; done
  [ -f "$RUN/kitsns" ] && rm -f "/dev/shm/aurora-kits-$(id -u)-$(cat "$RUN/kitsns")"
  rm -rf "$RUN"
}
if [ -f "$RUN/pid" ]; then
  if kill -0 "$(cat "$RUN/pid")" 2>/dev/null; then die "a stack is already running (pid $(cat "$RUN/pid"), $RUN); stop it first or use --run DIR"; fi
  say "(cleaning up a stale run in $RUN)"; sweep
fi
mkdir -p "$RUN" "$XDG_RUNTIME_DIR" && chmod 700 "$RUN" "$XDG_RUNTIME_DIR" || die "cannot create $RUN"
echo $$ > "$RUN/pid"; echo "$AURORA_KITS_NS" > "$RUN/kitsns"

CLEANED=0
cleanup() {
  [ $CLEANED = 1 ] && return; CLEANED=1; trap '' INT TERM
  say; say "== shutting down"
  for ((i=${#PIDS[@]}-1; i>=0; i--)); do
    p=${PIDS[$i]}; kill "$p" 2>/dev/null && say "   stopped ${NAMES[$i]} ($p)"
  done
  for p in "${PIDS[@]:-}"; do [ -n "$p" ] && wait "$p" 2>/dev/null; done
  jobs -p | xargs -r kill 2>/dev/null; wait 2>/dev/null
  sweep; say "   removed domains, sockets and $RUN"
}
trap cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM

start() {  # start NAME LOGFILE cmd...
  local n=$1 log=$2; shift 2
  "$@" >"$log" 2>&1 & PIDS+=($!); NAMES+=("$n")
}
waitfor() {  # waitfor DESC TIMEOUT_TENTHS cond...
  local d=$1 t=$2; shift 2
  for _ in $(seq "$t"); do "$@" && return 0; sleep 0.1; done
  say "aurora-up: timed out waiting for $d" >&2; return 1
}
alive() { kill -0 "${PIDS[$1]}" 2>/dev/null; }

# ---------------------------------------------------------------- start
say "== starting (run dir $RUN)"
# busd, controllerd and indexd run under supervisord (restart with backoff, a
# crash-loop give-up, health judged on the bus, supervisor.service.* events).
# The compositor is a fourth supervised service: kill -9 it and it comes back with
# its window placements and shell state (compositor-state.json, theme/), and the
# supervisor publishes supervisor.service.crashed. Its CLIENTS do not survive:
# they lose their wayland socket with it (no display proxy yet). The service list
# is data: this file.
mkdir -p "$RUN/index/queries" "$RUN/supervisor"
cat > "$RUN/index/queries/images-today.query" <<'Q'
# Seeded by aurora-up so `aurora query` has something to show.
title: Images written today
mime: image/*
since: today
Q
jstr() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }
svc_entry() {  # NAME LOGFILE HEALTH_JSON NEEDS_JSON EXTRA_JSON cmd...
  local n=$1 log=$2 h=$3 needs=$4 extra=$5 a cmd=; shift 5
  for a in "$@"; do cmd+="${cmd:+,}$(jstr "$a")"; done
  printf '{"name":"%s","log":%s,"health":%s,"needs":%s%s,"command":[%s]}' "$n" "$(jstr "$log")" "$h" "$needs" "$extra" "$cmd"
}
svc_healthy() { "$BIN/auroractl" status --json 2>/dev/null | grep -q "\"name\":\"$1\",\"state\":\"running\",\"health\":\"healthy\""; }
svc_diag() { "$BIN/auroractl" status 2>&1; tail -5 "$RUN/$1.log" 2>/dev/null; }

APPS=$ROOT/apps; [ $FIXTURES = 1 ] && APPS=$APPS,$ROOT/controller/testdata/apps
COMPFLAGS=()
if [ $COMPOSITOR = 1 ]; then COMPFLAGS=(--compositor-socket "$AURORA_TRUSTED_SOCK"); else COMPFLAGS=(--no-compositor-approval); fi
{
  printf '{"services":[\n'
  svc_entry busd "$RUN/busd.log" '{"type":"bus"}' '[]' '' "$BIN/busd" --socket "$AURORA_BUS_SOCK" --data-dir "$RUN/buslog"; printf ',\n'
  svc_entry controllerd "$RUN/controllerd.log" '{"type":"service","name":"registry"}' '["busd"]' '' \
    "$BIN/controllerd" --apps "$APPS" --domain-bin "$BIN/domain" --approval-timeout "$APPROVAL" ${ISOLATION:+"$ISOLATION"} "${COMPFLAGS[@]}"; printf ',\n'
  svc_entry indexd "$RUN/indexd.log" '{"type":"service","name":"index"}' '["busd"]' '' "$BIN/indexd" --socket "$AURORA_BUS_SOCK" --data-dir "$RUN/index"
  if [ $COMPOSITOR = 1 ]; then
    printf ',\n'
    cp -r "$ROOT/contracts/theme" "$RUN/theme"   # a copy: edit it and the compositor hot-reloads it; settings edits land here and survive a restart
    FLAGS=(--headless="$SIZE" --bus-socket "$AURORA_BUS_SOCK" --trusted-socket "$AURORA_TRUSTED_SOCK" --theme "$RUN/theme" --state-file "$RUN/compositor-state.json" --aurora "$BIN/aurora")
    [ $TESTINPUT = 1 ] && FLAGS+=(--test-input "$INPUT")
    [ -n "$DUMP" ] && FLAGS+=(--dump-overlay "$DUMP")
    svc_entry compositor "$RUN/compositor.log" '{"type":"none"}' '["busd"]' '' "$COMP" "${FLAGS[@]}"
  fi
  printf '\n]}\n'
} > "$RUN/services.json"
start supervisord "$RUN/supervisord.log" "$BIN/supervisord" --config "$RUN/services.json" --control "$AURORA_SUPERVISOR_SOCK" \
  --bus-socket "$AURORA_BUS_SOCK" --children-file "$RUN/supervisor/children"
waitfor "supervisor control socket" 100 test -S "$AURORA_SUPERVISOR_SOCK" || { cat "$RUN/supervisord.log"; exit 1; }
waitfor busd 100 test -S "$AURORA_BUS_SOCK" || { svc_diag busd; exit 1; }
waitfor "busd healthy" 100 svc_healthy busd || { svc_diag busd; exit 1; }

WL=
COMPFLAGS=()
if [ $COMPOSITOR = 1 ]; then
  waitfor "compositor socket" 150 grep -q '^aurora-compositor: socket wayland' "$RUN/compositor.log" || { tail -5 "$RUN/compositor.log"; exit 1; }
  WL=$(sed -n 's/^aurora-compositor: socket //p' "$RUN/compositor.log" | tail -1)
  if [ $WINDOWS = 1 ] && [ -x "$EXAMPLES/testclient" ]; then
    export WAYLAND_DISPLAY=$WL
    start "scene: split window" "$RUN/win0.log" "$EXAMPLES/testclient" --size 400x500 --pattern split
    waitfor "window 0" 100 grep -q enter "$RUN/win0.log"
    start "scene: glass window" "$RUN/win1.log" "$EXAMPLES/testclient" --size 400x300 --pattern glass --rgb 255,255,255 --alpha 0.05
    waitfor "window 1" 100 grep -q mapped "$RUN/win1.log"
    if [ $TESTINPUT = 1 ]; then
      printf 'move 0 100 50\nmove 1 200 150\n' | while read -r l; do echo "$l" | socat - "UNIX-CONNECT:$INPUT" >/dev/null; sleep 0.2; done
    fi
    unset WAYLAND_DISPLAY
  fi
fi

waitfor controllerd 150 svc_healthy controllerd || { svc_diag controllerd; exit 1; }
# indexd turns the provenance events controllerd publishes into live queries; it
# has been up since busd was, and subscribes, so ordering does not matter.
waitfor indexd 150 svc_healthy indexd || { svc_diag indexd; exit 1; }

HAIKU_UP=0
if [ $HAIKU = 1 ]; then
  start "haiku_ledger" "$RUN/haiku.out" "$LEDGER"
  waitfor "haiku_ledger" 100 grep -q READY "$RUN/haiku.out" && HAIKU_UP=1
fi

ISO="yes (bwrap domains, one subuid each)"
grep -qiE 'unisolated|WITHOUT|not found' "$RUN/controllerd.log" && ISO="NO: see $RUN/controllerd.log"
command -v bwrap >/dev/null || ISO="NO: bwrap not installed"

# ---------------------------------------------------------------- env file and banner
{
  echo "export PATH=\"$BIN:\$PATH\""
  for v in XDG_RUNTIME_DIR AURORA_DOMAINS_DIR AURORA_BUS_SOCK AURORA_TRUSTED_SOCK AURORA_DOMAIN_BIN AURORA_KITS_NS AURORA_SUPERVISOR_SOCK; do echo "export $v=\"${!v}\""; done
  [ -n "$WL" ] && { echo "export AURORA_WAYLAND=\"$WL\""; echo "export AURORA_CAPTURE=\"$CAPTURE\""; }
  [ $TESTINPUT = 1 ] && [ $COMPOSITOR = 1 ] && echo "export AURORA_INPUT_SOCK=\"$INPUT\""
} > "$RUN/env"
touch "$RUN/ready"

pidn() { for i in "${!NAMES[@]}"; do [ "${NAMES[$i]}" = "$1" ] && { echo "${PIDS[$i]}"; return; }; done; "$BIN/auroractl" pid "$1" 2>/dev/null; }
APPROVER="the bus (terminal prompt in 'aurora watch')"; [ $COMPOSITOR = 1 ] && APPROVER="the compositor's trusted overlay"
cat <<EOF

== Aurora is up
   busd          pid $(pidn busd)   $AURORA_BUS_SOCK
   controllerd   pid $(pidn controllerd)   registry service on the bus; approvals via $APPROVER
   indexd        pid $(pidn indexd)   live queries over provenance; a domain sees only its own files (index/README.md)
   supervisor    pid $(pidn supervisord)   restarts busd/controllerd/indexd/compositor on failure: auroractl status | restart NAME | stop NAME | start NAME
EOF
[ $COMPOSITOR = 1 ] && cat <<EOF
   compositor    pid $(pidn compositor)   headless $SIZE, wayland display $RUN/xdg/$WL
                 trusted socket  $AURORA_TRUSTED_SOCK
EOF
[ $COMPOSITOR = 1 ] && [ $TESTINPUT = 1 ] && say "                 test-input      $INPUT   (headless has no keyboard; keys go in here)"
[ $HAIKU_UP = 1 ] && say "   haiku_ledger  a Haiku BApplication serving verbs add@v1 / list@v1 on the bus as service 'haiku-ledger'"
# Windowed apps (decision 0012) are manifests whose exec is a CMake target; without HAIKU_SRC they do not exist.
# The registry already reports each one; say so here too instead of leaving it to be discovered at click time.
MISSING=$("$BIN/aurora" apps 2>/dev/null | grep -c 'windowed: UNAVAILABLE')
[ "${MISSING:-0}" -gt 0 ] && say "   windowed apps $MISSING listed but NOT launchable (binary not built; needs HAIKU_SRC and cmake/ninja). See: aurora apps"
say "   isolation     $ISO"
say "   logs          $RUN/*.log, $RUN/*.out"

cat <<EOF

== Try it (in another terminal)
   source $RUN/env          # puts the tools on PATH and points them at this stack
   aurora apps; aurora verbs --accepts image/png
   genimage /tmp/photo.png && aurora open /tmp/photo.png --verb resize@v1 --app org.aurora.lumen --arg width=300
   controller provenance /tmp/photo.resize.png --verify
EOF
if [ $COMPOSITOR = 1 ]; then cat <<EOF
   "\$AURORA_CAPTURE" --display "\$AURORA_WAYLAND" -o /tmp/screen.png     # a real frame from the compositor
EOF
  [ $TESTINPUT = 1 ] && cat <<EOF
   key() { echo "key \$1" | socat - UNIX-CONNECT:\$AURORA_INPUT_SOCK; }
   echo "down alt" | socat - UNIX-CONNECT:\$AURORA_INPUT_SOCK; key Tab    # open the Flip 3D switcher, then capture it
   key Escape; echo "up alt" | socat - UNIX-CONNECT:\$AURORA_INPUT_SOCK    # close it
   # approval: run a destructive verb, then press the key at the compositor's prompt:
   controller invoke org.aurora.demo delete@v1 --input /tmp/photo.png --output /tmp/gone.png &
   sleep 2; key a    # allow ('d' denies; it times out to deny in $APPROVAL)
EOF
fi
[ $HAIKU_UP = 1 ] && say "   bus send haiku-ledger add@v1 '{\"label\":\"coffee\",\"cents\":350}'"
say "   auroractl status                                       # pid, uptime, restarts, last exit, health
   bus inspect; bus log | tail
   aurora query; aurora query run images-today --watch   # then run the open above again
   aurora activity                                        # the whole recorded history, correlated"
say
say "Ctrl-C here stops everything and cleans up."

GAVE_WARNED=
while true; do
  for i in "${!PIDS[@]}"; do
    if ! alive "$i"; then
      case "${NAMES[$i]}" in
        supervisord) say "aurora-up: ${NAMES[$i]} exited; see $RUN/"; exit 1;;
      esac
    fi
  done
  # The supervisor restarts what dies. It gives up on a crash loop; busd and
  # controllerd gone for good means the stack is not usable, so say so and stop.
  if gave=$("$BIN/auroractl" status -q 2>&1); then :; else
    case " $(echo $gave) " in
      *" busd "*|*" controllerd "*) say "aurora-up: $(echo $gave) gave up after repeated crashes (auroractl status); see $RUN/"; exit 1;;
    esac
    [ "$gave" != "$GAVE_WARNED" ] && say "aurora-up: WARNING: $(echo $gave) gave up after repeated crashes; the rest keeps running (auroractl status, auroractl start NAME)"
    GAVE_WARNED=$gave
  fi
  sleep 1 & wait $!
done
