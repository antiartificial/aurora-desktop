#!/usr/bin/env bash
# atlas-demo: drive Atlas through a scripted walkthrough and record it.
#
# Brings up the whole stack -- busd, controllerd, the compositor headless, and
# Atlas -- then drives it through the test-input socket, capturing the
# compositor's own frame at each beat. The frames are assembled into an mp4 and
# a gif. Nothing here touches the host desktop; see --live for that.
#
# The point of recording it rather than describing it is that the compositor
# renders the frame, so what lands in the file is what a person would see,
# overlays and all. A demo that is a list of claims is not a demo.
#
#   harness/atlas-demo              headless, writes the reel
#   harness/atlas-demo --live       run the stack nested on the current desktop
#                                   instead, with Atlas inside it, and no reel
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${ATLAS_DEMO_OUT:-$ROOT/harness/atlas-demo-out}"
LIVE=0
[ "${1:-}" = "--live" ] && LIVE=1

ATLAS="$ROOT/kits/build/interface/atlas"
COMP="$ROOT/compositor/target/release/aurora-compositor"
CAP="$ROOT/harness/capture/target/release/aurora-capture"
for b in "$ATLAS" "$COMP"; do
  [ -x "$b" ] || { echo "atlas-demo: missing $b -- build it first" >&2; exit 2; }
done

# ---- a directory worth showing ----------------------------------------------------------------
# Named content, not a scratch dir: a reel of tmpXXXX directories demonstrates the widget and
# none of the point.
D=$(mktemp -d); W=$(mktemp -d); R=$(mktemp -d)
trap 'kill ${AP:-} ${CP:-} ${CD:-} ${BP:-} 2>/dev/null; rm -rf "$D" "$W" "$R"' EXIT
mkdir -p "$D"/{Documents,Pictures,Projects,Music}
mkdir -p "$D"/Projects/{aurora,atlas}
cat > "$D/README.md" <<'EOF'
Atlas
=====

A file explorer built on aurora::ui, which is built on our own canvas, text
and presenter -- not on BView and not on the app_server.

Everything in this window is a primitive from kits/aurora-ui/ui.h: the tree in
the sidebar, the divider you can drag, the list with its columns, the
breadcrumb, the scrollbars, and the menu that asks the plumber what can
actually be done with a file.

The preview pane you are reading this in links no decoder. Plain text is
rendered with the same text stack that draws the filenames; anything else is
preview@v1, a verb that runs in a domain holding the file read-only.
EOF
printf 'x' > "$D/photo.png"
printf 'notes\n' > "$D/Documents/notes.txt"
head -c 4096 /dev/urandom > "$D/archive.zip"

# ---- the bus, so the context menu shows real verbs ---------------------------------------------
"$ROOT/kits/build/busd" --data-dir "$W/buslog" 2>"$W/busd.err" & BP=$!
for _ in $(seq 100); do grep -q "listening on" "$W/busd.err" 2>/dev/null && break; sleep 0.05; done
AURORA_BUS_SOCK="$(grep -oE '/[^ ]*bus\.sock' "$W/busd.err" | head -1)"
[ -n "$AURORA_BUS_SOCK" ] || AURORA_BUS_SOCK=/run/user/$(id -u)/aurora/bus.sock
export AURORA_BUS_SOCK
if [ -x "$ROOT/build/bin/controllerd" ]; then
  "$ROOT/build/bin/controllerd" --socket "$AURORA_BUS_SOCK" --apps "$ROOT/apps" \
    --no-compositor-approval >"$W/ctl.log" 2>&1 & CD=$!
  sleep 1.2
else
  echo "atlas-demo: no controllerd; the context menu will show its no-registry reason" >&2
fi

# ---- live: nest on the current desktop and stop here -------------------------------------------
if [ "$LIVE" = 1 ]; then
  [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] || { echo "atlas-demo --live needs a graphical session" >&2; exit 2; }
  echo "atlas-demo: starting the compositor as a window on this desktop; close it to finish"
  "$COMP" >"$R/comp.log" 2>&1 & CP=$!
  for _ in $(seq 200); do grep -aq 'socket wayland' "$R/comp.log" && break; sleep 0.05; done
  sock=$(grep -aoE 'socket wayland-[0-9]+' "$R/comp.log" | head -1 | awk '{print $2}')
  [ -n "$sock" ] || { echo "atlas-demo: the compositor created no socket; see $R/comp.log" >&2; exit 1; }
  # Live keeps the REAL home, so the sidebar browses the actual filesystem -- the demo directory
  # is only where it starts, because its README explains what you are looking at. The recorded
  # reel overrides HOME instead, so the reel shows content chosen for it.
  env -u DISPLAY WAYLAND_DISPLAY="$sock" ATLAS_DIR="$D" "$ATLAS"
  exit 0
fi

# ---- headless: run, drive, capture -------------------------------------------------------------
[ -x "$CAP" ] || { echo "atlas-demo: missing $CAP (cargo build --release in harness/capture)" >&2; exit 2; }
rm -rf "$OUT"; mkdir -p "$OUT"
# The output is bigger than the window on purpose: Atlas opens at the design's 960x640 now,
# and the Deskbar's overlay lives at the top right of the OUTPUT -- a window that reaches it is
# recorded with it on top.
env -u WAYLAND_DISPLAY XDG_RUNTIME_DIR="$R" \
  "$COMP" --headless=1600x1000 --test-input "$R/ti" >"$R/comp.log" 2>&1 & CP=$!
for _ in $(seq 200); do [ -S "$R/ti" ] && grep -aq 'socket wayland' "$R/comp.log" && break; sleep 0.05; done
sock=$(grep -aoE 'socket wayland-[0-9]+' "$R/comp.log" | head -1 | awk '{print $2}')
[ -n "$sock" ] || { echo "atlas-demo: the compositor created no socket; see $R/comp.log" >&2; exit 1; }

env XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$sock" HOME="$D" ATLAS_DIR="$D" ATLAS_SIZE=960x640 \
  "$ATLAS" >"$R/atlas.out" 2>&1 & AP=$!
for _ in $(seq 200); do grep -aq 'deco: layout' "$R/comp.log" && break; sleep 0.05; done
sleep 1.0

n=0
# Where the window landed, from the compositor's own layout line. Every pointer coordinate
# below is then WINDOW-relative (ti.py's TI_OFFSET), which is what stops this script from
# clicking on a decoration the day the title bar changes height. The previous version held
# absolute numbers with a comment saying they had been read off a capture, and adding one
# toolbar control silently turned its "View" click into a click on something else -- the reel
# went on looking plausible while testing the wrong things.
geom=$(grep -a 'deco: layout' "$R/comp.log" | tail -1 | grep -oE 'window=[0-9]+,[0-9]+,[0-9]+,[0-9]+' | cut -d= -f2)
IFS=, read -r WX WY WW WH <<<"$geom"
export TI_OFFSET="$WX,$WY"
ti() { python3 -I "$ROOT/demos/kitchen-sink/ti.py" "$R/ti" --pause 0.08 "$@" >/dev/null 2>&1; }
# Each beat is captured several times so it HOLDS in the reel. Capturing is the slow part, so
# the hold is frames rather than a sleep: a reel that flashes each state for 40 ms shows nothing.
beat() {
  local hold=${2:-6}
  for _ in $(seq "$hold"); do
    n=$((n + 1))
    env XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$sock" \
      "$CAP" -o "$(printf '%s/f%04d.png' "$OUT" "$n")" >/dev/null 2>&1
  done
  echo "  beat: $1 (through frame $n)"
}

# The toolbar of docs/atlas-design.md 2.1, in window coordinates. The left cluster starts at
# 8 and is four 28 px buttons 4 apart (the sidebar toggle, Back, Forward, Up); the right one is
# counted back from the right edge: the preview toggle, then the 38-wide view menu button.
TB_Y=22
PREVIEW_X=$((WW - 22)); VIEW_X=$((WW - 59))
# The list: rows are 24 tall and start under the 44 px toolbar and the 26 px header.
row_y() { echo $((71 + 24 * $1 + 12)); }
# The fixture's own order: folders first, then the files case-insensitively -- Documents,
# Music, Pictures, Projects, archive.zip, photo.png, README.md. Guessing it the other way round
# previewed the zip and called it the README in the log, which is the sort of thing a reel
# states confidently and nobody checks.
PNG_Y=$(row_y 5); README_Y=$(row_y 6)

echo "atlas-demo: recording"
beat "Atlas opens: the toolbar is icons with the location in it"
ti "pointer 16 57" click;                    beat "the twisty expands Home in place, without navigating"
ti "pointer $VIEW_X $TB_Y" click;            beat "the view menu, under the button it belongs to"
ti "key Escape";                             beat "dismissed" 3
ti "pointer $PREVIEW_X $TB_Y" click;         beat "the preview pane reveals"
ti "pointer 300 $README_Y" click;            beat "README.md previews in process: text needs no decoder"
ti "pointer 300 $PNG_Y" rclick;              beat "the plumber says what can be done with a PNG"
ti "key Escape";                             beat "dismissed" 3
ti "pointer 60 57" click;                    beat "clicking a place in the sidebar navigates"
ti "pointer 202 300" press "pointer 320 300" "sleep 0.2" "pointer 320 300" release
                                             beat "and the divider is yours to drag"

kill $AP 2>/dev/null

# ---- assemble -----------------------------------------------------------------------------------
if command -v ffmpeg >/dev/null 2>&1; then
  ffmpeg -y -framerate 6 -i "$OUT/f%04d.png" -vf "crop=$WW:$WH:$WX:$WY,scale=1050:-2:flags=lanczos" \
    -c:v libx264 -pix_fmt yuv420p -movflags +faststart "$OUT/atlas.mp4" >/dev/null 2>&1 \
    && echo "atlas-demo: $OUT/atlas.mp4"
  ffmpeg -y -framerate 6 -i "$OUT/f%04d.png" \
    -vf "crop=$WW:$WH:$WX:$WY,scale=960:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" \
    "$OUT/atlas.gif" >/dev/null 2>&1 && echo "atlas-demo: $OUT/atlas.gif"
else
  echo "atlas-demo: no ffmpeg; the frames are in $OUT"
fi
echo "atlas-demo: $n frames in $OUT"
